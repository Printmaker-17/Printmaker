      <button class="icon-btn danger" onclick="delSz('${s.id}')"><i class="ti ti-trash"></i></button>
    </div></td>
  </tr>`).join('');
}
function toggleSzForm(){document.getElementById('sz-form').classList.toggle('open')}
function openSzForm(id){
  editSzId=id||null;const sz=sizes.find(x=>x.id===id);
  document.getElementById('sz-form-title').textContent=id?'Edit size':'New size';
  document.getElementById('sz-name').value=sz?sz.name:'';document.getElementById('sz-div').value=sz?sz.div:'';document.getElementById('sz-desc').value=sz?sz.desc||'':'';
  document.getElementById('sz-form').classList.add('open');document.getElementById('sz-name').focus();
}
function closeSzForm(){document.getElementById('sz-form').classList.remove('open');editSzId=null}
function saveSz(){
  const name=document.getElementById('sz-name').value.trim();if(!name){alert('Enter a size label.');return}
  const sz={id:editSzId||uid(),name,div:parseFloat(document.getElementById('sz-div').value)||1,desc:document.getElementById('sz-desc').value.trim()};
  sizes=editSzId?sizes.map(x=>x.id===editSzId?sz:x):[...sizes,sz];
  dbSet(DB.sizes,sizes);editSzId=null;closeSzForm();renderSz();
}
function delSz(id){if(!confirm('Delete?'))return;sizes=sizes.filter(s=>s.id!==id);dbSet(DB.sizes,sizes);renderSz()}

// ── QUOTE BUILDER ──
function onQClientSearch(){
  const q=document.getElementById('q-client-input').value.trim().toLowerCase();
  const dd=document.getElementById('q-client-dropdown');qClientFocusIdx=-1;
  const matches=q?clients.filter(c=>c.name.toLowerCase().includes(q)||(c.phone||'').includes(q)):clients;
  dd.innerHTML=[...matches.map(c=>`
    <div class="sd-item" onclick="selectQClient('${c.id}')">
      <div class="sd-av">${initials(c.name)}</div>
      <div><div style="font-weight:500;font-size:12px;color:var(--text)">${c.name}</div><div style="font-size:10px;color:var(--text2)">${c.phone||''}${c.email?' · '+c.email:''}</div></div>
    </div>`),
    `<div class="sd-item" onclick="showQNewClient()">
      <div class="sd-av new-av"><i class="ti ti-plus" style="font-size:12px"></i></div>
      <div><div style="font-weight:500;font-size:12px;color:var(--text)">New client…</div><div style="font-size:10px;color:var(--text2)">Add to client list</div></div>
    </div>`
  ].join('');
  dd.style.display='block';
}
function onQClientKey(e){
  const items=document.getElementById('q-client-dropdown').querySelectorAll('.sd-item');if(!items.length)return;
  if(e.key==='ArrowDown'){e.preventDefault();qClientFocusIdx=Math.min(qClientFocusIdx+1,items.length-1);items.forEach((el,i)=>el.classList.toggle('focused',i===qClientFocusIdx))}
  else if(e.key==='ArrowUp'){e.preventDefault();qClientFocusIdx=Math.max(qClientFocusIdx-1,0);items.forEach((el,i)=>el.classList.toggle('focused',i===qClientFocusIdx))}
  else if(e.key==='Enter'&&qClientFocusIdx>=0)items[qClientFocusIdx].click();
  else if(e.key==='Escape')document.getElementById('q-client-dropdown').style.display='none';
}
document.addEventListener('click',e=>{if(!e.target.closest('.search-wrap'))document.getElementById('q-client-dropdown').style.display='none'});
function selectQClient(id){
  const c=clients.find(x=>x.id===id);if(!c)return;
  qSelectedClient=c;
  document.getElementById('q-client-input').value=c.name;
  document.getElementById('q-client-dropdown').style.display='none';
  document.getElementById('q-cc-avatar').textContent=initials(c.name);
  document.getElementById('q-cc-name').textContent=c.name;
  document.getElementById('q-cc-details').textContent=[c.phone,c.email,c.address].filter(Boolean).join(' · ');
  document.getElementById('q-client-card').style.display='flex';
  document.getElementById('q-client-search-wrap').style.display='none';
  calcQ();
}
function clearQClient(){
  qSelectedClient=null;document.getElementById('q-client-input').value='';
  document.getElementById('q-client-card').style.display='none';
  document.getElementById('q-client-search-wrap').style.display='block';
  document.getElementById('q-new-client-block').style.display='none';
  calcQ();
}
function showQNewClient(){document.getElementById('q-client-dropdown').style.display='none';document.getElementById('q-new-client-block').style.display='block'}
function cancelQNewClient(){document.getElementById('q-new-client-block').style.display='none';document.getElementById('q-client-input').value=''}
function saveQNewClient(){
  const name=document.getElementById('qnc-name').value.trim();const phone=document.getElementById('qnc-phone').value.trim();
  if(!name||!phone){alert('Name and phone are required.');return}
  const c={id:uid(),name,phone,email:document.getElementById('qnc-email').value.trim(),address:document.getElementById('qnc-address').value.trim()};
  clients=[c,...clients];dbSet(DB.clients,clients);
  qSelectedClient=c;
  document.getElementById('q-cc-avatar').textContent=initials(c.name);
  document.getElementById('q-cc-name').textContent=c.name;
  document.getElementById('q-cc-details').textContent=[phone,c.email,c.address].filter(Boolean).join(' · ');
  document.getElementById('q-client-card').style.display='flex';
  document.getElementById('q-client-search-wrap').style.display='none';
  document.getElementById('q-new-client-block').style.display='none';
  renderClients();calcQ();
}

function qSzOpts(){return'<option value="">— select —</option>'+sizes.map(s=>`<option value="${s.id}">${s.name} (÷${s.div})</option>`).join('')}
function qRuleOpts(){return'<option value="">— select —</option>'+pricing.map(r=>`<option value="${r.id}">${r.name}</option>`).join('')}
function qMatOpts(){return'<option value="">— select —</option>'+materials.map(m=>`<option value="${m.id}">${m.name}${m.size?' ('+m.size+')':''}</option>`).join('')}
function qPPOpts(){return'<option value="">— select —</option>'+printpricing.map(p=>`<option value="${p.id}">${p.name} — $${p.rate.toFixed(3)}/sheet</option>`).join('')}
function qJTOpts(){return'<option value="">— select —</option>'+jobtypes.map(jt=>`<option value="${jt.name}">${jt.name}</option>`).join('')}

function addQJob(){
  const id='qj'+(++qJobIdCounter);
  qJobs.push({id});
  const el=document.createElement('div');el.className='job-block';el.id='qjob-'+id;
  el.innerHTML=`
    <div class="job-hdr">
      <span style="font-size:12px;font-weight:500;color:var(--text)" id="qjnum-${id}">Job 1</span>
      <button class="btn btn-xs btn-danger" onclick="removeQJob('${id}')"><i class="ti ti-trash"></i>Remove</button>
    </div>
    <div class="form-row four">
      <div class="fg"><label>Job type <span class="req">*</span></label><select id="qjt-${id}" class="err" onchange="calcQ()">${qJTOpts()}</select></div>
      <div class="fg"><label>Quantity <span class="req">*</span></label><input type="number" id="qqty-${id}" placeholder="e.g. 500" min="1" class="err" oninput="calcQ()"></div>
      <div class="fg"><label>Material <span class="req">*</span></label><select id="qmat-${id}" class="err" onchange="calcQ()">${qMatOpts()}</select></div>
      <div class="fg"><label>Size <span class="req">*</span></label><select id="qsz-${id}" class="err" onchange="calcQ()">${qSzOpts()}</select></div>
    </div>
    <div class="form-row" style="margin-top:8px">
      <div class="fg"><label>Print type <span class="req">*</span></label><select id="qpp-${id}" class="err" onchange="calcQ()">${qPPOpts()}</select></div>
      <div class="fg"><label>Pricing rule <span class="req">*</span></label><select id="qrule-${id}" class="err" onchange="calcQ()">${qRuleOpts()}</select></div>
    </div>
    <div class="fg" style="margin-top:8px"><label>Notes <span class="opt">(optional)</span></label><textarea id="qnotes-${id}" rows="2" placeholder="e.g. Matte finish, bleed 0.125 in…" oninput="calcQ()"></textarea></div>
    <div class="formula-box" id="qformula-${id}">Complete all fields above to see pricing.</div>`;
  document.getElementById('q-jobs-container').appendChild(el);
  renumberQJobs();calcQ();
}
function removeQJob(id){qJobs=qJobs.filter(j=>j.id!==id);document.getElementById('qjob-'+id)?.remove();renumberQJobs();calcQ()}
function renumberQJobs(){document.querySelectorAll('.job-block').forEach((el,i)=>{const id=el.id.replace('qjob-','');const n=document.getElementById('qjnum-'+id);if(n)n.textContent='Job '+(i+1)})}

function calcQ(){
  const warn=document.getElementById('q-warn');const out=document.getElementById('q-output');
  if(!qJobs.length){warn.classList.add('hidden');out.classList.add('hidden');return}
  let allValid=!!qSelectedClient;let grandPre=0;
  const jobOuts=[],intLines=[];
  qJobs.forEach(job=>{
    const jtEl=document.getElementById('qjt-'+job.id);if(!jtEl)return;
    const qtyEl=document.getElementById('qqty-'+job.id);
    const matEl=document.getElementById('qmat-'+job.id);
    const szEl=document.getElementById('qsz-'+job.id);
    const ppEl=document.getElementById('qpp-'+job.id);
    const ruleEl=document.getElementById('qrule-'+job.id);
    const notesEl=document.getElementById('qnotes-'+job.id);
    const jt=jtEl.value,qty=parseInt(qtyEl.value)||0,matId=matEl.value,szId=szEl.value,ppId=ppEl.value,ruleId=ruleEl.value;
    const valid=jt&&qty>0&&matId&&szId&&ppId&&ruleId;
    jtEl.classList.toggle('err',!jt);qtyEl.classList.toggle('err',qty<=0);matEl.classList.toggle('err',!matId);
    szEl.classList.toggle('err',!szId);ppEl.classList.toggle('err',!ppId);ruleEl.classList.toggle('err',!ruleId);
    if(!valid){allValid=false;document.getElementById('qformula-'+job.id).textContent='Complete all fields above to see pricing.';return}
    const mat=materials.find(m=>m.id===matId);
    const sz=sizes.find(s=>s.id===szId);
    const pp=printpricing.find(p=>p.id===ppId);
    const rule=pricing.find(r=>r.id===ruleId);
    const costPerPiece=(mat.cost+pp.rate)/sz.div;
    const lineCost=costPerPiece*qty;
    const ruleBase=rule.base+(rule.perunit*qty);
    const preTax=(lineCost+ruleBase)*(1+rule.markup/100);
    grandPre+=preTax;
    const notes=notesEl?notesEl.value.trim():'';
    document.getElementById('qformula-'+job.id).textContent=`($${mat.cost.toFixed(3)} mat + $${pp.rate.toFixed(3)} print) ÷ ${sz.div} (${sz.name}) = $${costPerPiece.toFixed(4)}/pc × ${qty} = $${lineCost.toFixed(2)} + rule $${ruleBase.toFixed(2)} + ${rule.markup}% = $${preTax.toFixed(2)}`;
    jobOuts.push({jt,qty,mat:mat.name,sz:sz.name,pp:pp.name,notes,preTax});
    intLines.push(`<div><strong>Job ${jobOuts.length}: ${jt}</strong> — ($${mat.cost.toFixed(3)}+$${pp.rate.toFixed(3)})÷${sz.div}=$${costPerPiece.toFixed(4)}/pc×${qty}+rule $${ruleBase.toFixed(2)}+${rule.markup}% = <strong>$${preTax.toFixed(2)}</strong></div>`);
  });
  if(!allValid){warn.classList.remove('hidden');out.classList.add('hidden');return}
  warn.classList.add('hidden');out.classList.remove('hidden');
  const tax=grandPre*TAX,grand=grandPre+tax;
  const c=qSelectedClient;
  document.getElementById('q-out-name').textContent=c.name;
  document.getElementById('q-out-details').textContent=[c.phone,c.email,c.address].filter(Boolean).join(' · ');
  document.getElementById('q-out-date').textContent=new Date().toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'});
  document.getElementById('q-out-jobs').innerHTML=jobOuts.map((j,i)=>`
    <div class="q-job-block">
      <div class="q-job-title">Job ${i+1}: ${j.jt}</div>
      <div class="q-row"><span style="color:var(--text2)">Quantity</span><span style="font-weight:500">${j.qty} units</span></div>
      <div class="q-row"><span style="color:var(--text2)">Material</span><span style="font-weight:500">${j.mat}</span></div>
      <div class="q-row"><span style="color:var(--text2)">Size</span><span style="font-weight:500">${j.sz}</span></div>
      <div class="q-row"><span style="color:var(--text2)">Print type</span><span style="font-weight:500">${j.pp}</span></div>
      ${j.notes?`<div class="q-row"><span style="color:var(--text2)">Notes</span><span style="font-weight:500;max-width:55%;text-align:right;white-space:normal">${j.notes}</span></div>`:''}
    </div>`).join('');
  document.getElementById('q-out-sub').textContent=fmt(grandPre);
  document.getElementById('q-out-tax').textContent=fmt(tax);
  document.getElementById('q-out-total').textContent=fmt(grand);
  document.getElementById('q-internal').innerHTML=intLines.join('');
}
function quoteToOrder(){
  if(!qSelectedClient||!qJobs.length)return;
  const firstJob=qJobs[0];const jtEl=document.getElementById('qjt-'+firstJob.id);
  editOId=null;document.getElementById('o-form-title').textContent='New work order (from quote)';
  document.getElementById('f-client').value=qSelectedClient.name;
  document.getElementById('f-contact').value=qSelectedClient.phone||'';
  document.getElementById('f-jobtype').value=jtEl?jtEl.value:'';
  document.getElementById('f-status').value='Pending';document.getElementById('f-duedate').value='';
  document.getElementById('f-notes').value='From quote';
  lineItems=[{id:uid(),desc:'Quote — see details',qty:1,price:parseFloat(document.getElementById('q-out-total').textContent.replace('$',''))||0}];
  renderLIs();showView('new-order');
}

// ── PDF ──
function buildOrderPDF(o){
  const{jsPDF}=window.jspdf;const doc=new jsPDF({unit:'pt',format:'letter'});
  const W=612,M=50;let y=M;
  doc.setFillColor(29,158,117);doc.rect(0,0,W,52,'F');
  doc.setTextColor(255,255,255);doc.setFontSize(16);doc.setFont('helvetica','bold');doc.text('Printmaker IAPP',M,32);
  doc.setFontSize(9);doc.setFont('helvetica','normal');doc.text('Work Order',M,44);
  doc.text('#'+o.id.toUpperCase().slice(-6),W-M,28,{align:'right'});
  doc.text(new Date(o.created).toLocaleDateString(),W-M,40,{align:'right'});
  y=70;doc.setTextColor(20,20,20);doc.setFontSize(13);doc.setFont('helvetica','bold');doc.text(o.client,M,y);y+=15;
  if(o.contact){doc.setFontSize(9);doc.setFont('helvetica','normal');doc.setTextColor(100,100,100);doc.text(o.contact,M,y);y+=12}
  doc.setFontSize(9);doc.setTextColor(100,100,100);
  if(o.duedate){doc.text('Due: '+o.duedate,M,y);y+=11}
  doc.text('Job: '+o.jobtype,M,y);y+=11;
  const sc={'Pending':[186,117,11],'In Progress':[24,95,165],'Completed':[59,109,17],'Cancelled':[163,45,45]};
  doc.setTextColor(...(sc[o.status]||[100,100,100]));doc.text('Status: '+o.status,M,y);y+=18;
  if(o.notes){doc.setTextColor(60,60,60);const w=doc.splitTextToSize('Notes: '+o.notes,W-M*2);doc.text(w,M,y);y+=w.length*12+4}
  doc.setDrawColor(200,200,200);doc.line(M,y,W-M,y);y+=12;
  doc.setFontSize(8);doc.setFont('helvetica','bold');doc.setTextColor(120,120,120);
  doc.text('DESCRIPTION',M,y);doc.text('QTY',310,y);doc.text('UNIT PRICE',378,y);doc.text('SUBTOTAL',W-M,y,{align:'right'});
  y+=5;doc.line(M,y,W-M,y);y+=11;
  doc.setFont('helvetica','normal');doc.setFontSize(10);doc.setTextColor(20,20,20);
  (o.lineItems||[]).forEach(li=>{const sub=(+li.qty)*(+li.price);doc.text(li.desc||'—',M,y,{maxWidth:240});doc.text(String(li.qty),310,y);doc.text(fmt(li.price),378,y);doc.text(fmt(sub),W-M,y,{align:'right'});y+=15});
  doc.setDrawColor(200,200,200);doc.line(M,y,W-M,y);y+=12;
  doc.setFontSize(9);doc.setTextColor(100,100,100);doc.text('Subtotal:',W-M-95,y);doc.text(fmt(+o.subtotal||0),W-M,y,{align:'right'});y+=12;
  doc.text('Tax (11.5%):',W-M-95,y);doc.text(fmt((+o.subtotal||0)*TAX),W-M,y,{align:'right'});y+=12;
  doc.setFont('helvetica','bold');doc.setFontSize(12);doc.setTextColor(29,158,117);
  doc.text('TOTAL:',W-M-95,y);doc.text(fmt(o.total),W-M,y,{align:'right'});
  y+=26;doc.setFontSize(8);doc.setFont('helvetica','normal');doc.setTextColor(160,160,160);doc.text('Thank you for your business!',W/2,y,{align:'center'});
  return doc;
}
function exportOrderPDF(){
  const client=document.getElementById('f-client').value.trim();if(!client){alert('Enter client info first.');return}
  const sub=calcSub();
  const o={id:editOId||uid(),client,contact:document.getElementById('f-contact').value.trim(),jobtype:document.getElementById('f-jobtype').value,status:document.getElementById('f-status').value,duedate:document.getElementById('f-duedate').value,notes:document.getElementById('f-notes').value.trim(),lineItems:JSON.parse(JSON.stringify(lineItems)),subtotal:sub,total:sub+sub*TAX,created:Date.now()};
  buildOrderPDF(o).save('workorder-'+client.replace(/\s+/g,'-')+'.pdf');
}
function pdfOrder(id){const o=orders.find(x=>x.id===id);if(!o)return;buildOrderPDF(o).save('workorder-'+o.client.replace(/\s+/g,'-')+'.pdf')}
function exportQuotePDF(){
  const{jsPDF}=window.jspdf;const doc=new jsPDF({unit:'pt',format:'letter'});
  const W=612,M=50;let y=M;
  const c=qSelectedClient;if(!c)return;
  const grandTotal=document.getElementById('q-out-total').textContent;
  const sub=document.getElementById('q-out-sub').textContent;
  const tax=document.getElementById('q-out-tax').textContent;
  doc.setFillColor(29,158,117);doc.rect(0,0,W,52,'F');
  doc.setTextColor(255,255,255);doc.setFontSize(16);doc.setFont('helvetica','bold');doc.text('Printmaker IAPP',M,32);
  doc.setFontSize(9);doc.setFont('helvetica','normal');doc.text('Quote / Estimate',M,44);
  doc.text(new Date().toLocaleDateString(),W-M,40,{align:'right'});
  y=70;doc.setTextColor(20,20,20);doc.setFontSize(13);doc.setFont('helvetica','bold');doc.text('Quote for: '+c.name,M,y);y+=15;
  doc.setFontSize(9);doc.setFont('helvetica','normal');doc.setTextColor(100,100,100);
  if(c.phone){doc.text(c.phone,M,y);y+=11}if(c.email){doc.text(c.email,M,y);y+=11}if(c.address){doc.text(c.address,M,y);y+=11}
  y+=6;doc.setDrawColor(200,200,200);doc.line(M,y,W-M,y);y+=12;
  const jobEls=document.querySelectorAll('.q-job-block');
  jobEls.forEach((el,i)=>{
    doc.setFontSize(10);doc.setFont('helvetica','bold');doc.setTextColor(20,20,20);doc.text(el.querySelector('.q-job-title').textContent,M,y);y+=13;
    el.querySelectorAll('.q-row').forEach(row=>{
      const cells=row.querySelectorAll('span');if(cells.length<2)return;
      doc.setFontSize(9);doc.setFont('helvetica','normal');doc.setTextColor(100,100,100);doc.text(cells[0].textContent,M,y);
      doc.setTextColor(20,20,20);doc.text(cells[1].textContent,W-M,y,{align:'right'});y+=12;
    });y+=6;
  });
  doc.setDrawColor(200,200,200);doc.line(M,y,W-M,y);y+=12;
  doc.setFontSize(9);doc.setTextColor(100,100,100);doc.text('Subtotal:',W-M-95,y);doc.text(sub,W-M,y,{align:'right'});y+=12;
  doc.text('Tax (11.5%):',W-M-95,y);doc.text(tax,W-M,y,{align:'right'});y+=12;
  doc.setFont('helvetica','bold');doc.setFontSize(12);doc.setTextColor(29,158,117);doc.text('TOTAL:',W-M-95,y);doc.text(grandTotal,W-M,y,{align:'right'});
  y+=26;doc.setFontSize(8);doc.setFont('helvetica','normal');doc.setTextColor(160,160,160);doc.text('This is an estimate. Final price may vary.',W/2,y,{align:'center'});
  doc.save('quote-'+c.name.replace(/\s+/g,'-')+'.pdf');
}

// ── EXCEL ──
function triggerImport(target){document.getElementById('xlsx-input').setAttribute('data-target',target);document.getElementById('xlsx-input').click()}
function handleXlsxFile(input){
  const file=input.files[0];if(!file)return;
  const target=input.getAttribute('data-target');
  const reader=new FileReader();
  reader.onload=e=>{
    try{const wb=XLSX.read(e.target.result,{type:'array'});if(target==='materials')parseMatsSheet(wb,file.name);else parsePricingSheet(wb,file.name);}
    catch(err){showBanner(target,'error','Could not read the Excel file.');console.error(err)}
    input.value='';
  };reader.readAsArrayBuffer(file);
}
function sheetToRows(wb,sheetName){
  const sheet=wb.Sheets[sheetName];if(!sheet)return null;
  const raw=XLSX.utils.sheet_to_json(sheet,{header:1,defval:''});if(raw.length<4)return[];
  const headers=raw[2].map(h=>String(h).trim().toLowerCase());const data=[];
  for(let i=3;i<raw.length;i++){const row=raw[i];if(row.every(c=>c===''||c===null||c===undefined))continue;const obj={};headers.forEach((h,j)=>{obj[h]=row[j]});data.push(obj)}
  return data;
}
function parseMatsSheet(wb,fname){
  const rows=sheetToRows(wb,'Materials');
  if(rows===null){showBanner('materials','error','Sheet "Materials" not found.');return}
  const parsed=rows.map(r=>({id:uid(),name:String(r['name']||'').trim(),category:String(r['category']||'Other').trim(),unit:String(r['unit']||'piece').trim(),size:String(r['size']||'').trim(),cost:parseFloat(r['cost per unit ($)']||r['cost']||0)||0,stock:parseInt(r['stock quantity']||r['stock']||0)||0,reorder:parseInt(r['reorder level']||r['reorder']||0)||0})).filter(r=>r.name);
  if(!parsed.length){showBanner('materials','error','No valid rows found.');return}
  pendingImport={type:'materials',data:parsed};showImportModal('materials',parsed,fname);
}
function parsePricingSheet(wb,fname){
  const rows=sheetToRows(wb,'Pricing Rules');
  if(rows===null){showBanner('pricing','error','Sheet "Pricing Rules" not found.');return}
  const parsed=rows.map(r=>({id:uid(),name:String(r['rule name']||r['name']||'').trim(),jobtype:String(r['job type']||'').trim(),base:parseFloat(r['base price ($)']||0)||0,perunit:parseFloat(r['price per unit ($)']||0)||0,minqty:parseInt(r['min quantity']||1)||1,markup:parseFloat(r['markup %']||0)||0,notes:String(r['notes']||'').trim()})).filter(r=>r.name);
  if(!parsed.length){showBanner('pricing','error','No valid rows found.');return}
  pendingImport={type:'pricing',data:parsed};showImportModal('pricing',parsed,fname);
}
function showImportModal(type,data,fname){
  const isM=type==='materials';
  document.getElementById('modal-title').textContent=`Import ${isM?'materials':'pricing rules'} from ${fname}`;
  const preview=data.slice(0,6);const more=data.length>6?`<p style="font-size:11px;color:var(--text3);margin-top:8px">… and ${data.length-6} more rows</p>`:'';
  document.getElementById('modal-body').innerHTML=`
    <div class="banner banner-success" style="margin-bottom:14px"><i class="ti ti-table-import"></i><span><strong>${data.length} rows</strong> ready from <em>${fname}</em>. Existing ${isM?'materials':'pricing rules'} will be replaced.</span></div>
    ${preview.map(r=>isM?`<div style="display:flex;justify-content:space-between;padding:7px 0;border-bottom:1px solid var(--border);font-size:12px"><span style="font-weight:500">${r.name}</span><span style="color:var(--text2)">${r.category} · ${r.unit}${r.size?' · '+r.size:''} · $${r.cost.toFixed(3)}</span></div>`:`<div style="display:flex;justify-content:space-between;padding:7px 0;border-bottom:1px solid var(--border);font-size:12px"><span style="font-weight:500">${r.name}</span><span style="color:var(--text2)">${r.jobtype||'Any'} · $${r.base.toFixed(2)} · ${r.markup}%</span></div>`).join('')}${more}`;
  document.getElementById('import-modal').classList.remove('hidden');
}
function confirmImport(){
  if(!pendingImport)return;
  if(pendingImport.type==='materials'){materials=pendingImport.data;dbSet(DB.mats,materials);renderMats();showBanner('materials','success',`${materials.length} materials imported.`)}
  else{pricing=pendingImport.data;dbSet(DB.pricing,pricing);renderP();showBanner('pricing','success',`${pricing.length} pricing rules imported.`)}
  pendingImport=null;closeModal();
}
function closeModal(){document.getElementById('import-modal').classList.add('hidden')}
function showBanner(view,type,msg){
  const id=view==='materials'?'mat-banner':'pricing-banner';const el=document.getElementById(id);
  el.className='banner '+(type==='success'?'banner-success':'banner-error');
  el.innerHTML=`<i class="ti ti-${type==='success'?'check':'alert-circle'}"></i><span>${msg}</span>`;
  el.classList.remove('hidden');if(type==='success')setTimeout(()=>el.classList.add('hidden'),5000);
}
function exportMatsExcel(){
  if(!materials.length){alert('No materials to export.');return}
  const wb=XLSX.utils.book_new();
  const ws=XLSX.utils.aoa_to_sheet([['Printmaker IAPP — Material Database'],['Blue values are editable inputs.'],['Name','Category','Unit','Size','Cost per unit ($)','Stock quantity','Reorder level'],...materials.map(m=>[m.name,m.category,m.unit,m.size||'',m.cost,m.stock,m.reorder])]);
  ws['!cols']=[{wch:28},{wch:18},{wch:10},{wch:14},{wch:18},{wch:15},{wch:14}];
  XLSX.utils.book_append_sheet(wb,ws,'Materials');addPricingSheetXL(wb);XLSX.writeFile(wb,'Printmaker_IAPP_Materials.xlsx');
}
function exportPricingExcel(){
  if(!pricing.length){alert('No pricing rules to export.');return}
  const wb=XLSX.utils.book_new();addMatsSheetXL(wb);addPricingSheetXL(wb);XLSX.writeFile(wb,'Printmaker_IAPP_Pricing.xlsx');
}
function addMatsSheetXL(wb){
  const ws=XLSX.utils.aoa_to_sheet([['Printmaker IAPP — Material Database'],[''],['Name','Category','Unit','Size','Cost per unit ($)','Stock quantity','Reorder level'],...materials.map(m=>[m.name,m.category,m.unit,m.size||'',m.cost,m.stock,m.reorder])]);
  XLSX.utils.book_append_sheet(wb,ws,'Materials');
}
function addPricingSheetXL(wb){
  const ws=XLSX.utils.aoa_to_sheet([['Printmaker IAPP — Pricing Rules'],[''],['Rule name','Job type','Base price ($)','Price per unit ($)','Min quantity','Markup %','Notes'],...pricing.map(p=>[p.name,p.jobtype||'',p.base,p.perunit,p.minqty||1,p.markup||0,p.notes||''])]);
  XLSX.utils.book_append_sheet(wb,ws,'Pricing Rules');
}

init();
addQJob();
</script>
</body>
</html>
